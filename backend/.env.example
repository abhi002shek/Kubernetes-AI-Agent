# OpenRouter API key — get one at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use via OpenRouter (free options available)
OPENROUTER_MODEL=qwen/qwen3-235b-a22b:free

# InsForge project credentials — get from https://insforge.dev
INSFORGE_URL=https://your-project-id.ap-southeast.insforge.app
INSFORGE_API_KEY=ik_your-api-key-here

# Optional: Slack webhook for investigation alerts
# Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Optional: path to a specific kubeconfig file
# Leave empty to use default (~/.kube/config)
KUBECONFIG_PATH=
