# Backend API URL (FastAPI)
# Local dev: http://localhost:8000
# Docker Compose still uses 8000 for the API from your browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# InsForge — get URL from .insforge/project.json (oss_host) after: npx @insforge/cli link
# Anon key: npx @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key-here
